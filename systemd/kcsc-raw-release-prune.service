[Unit]
Description=NON-DEPLOYABLE historical KCSC product-repository prune placeholder
# The operational unit is canonical only in aimesy/kcsc-ops. This condition is
# always false because the root directory exists.
ConditionPathExists=!/

[Service]
Type=oneshot
WorkingDirectory=/srv/kcsc
ExecStart=/usr/bin/env node /srv/kcsc/scripts/prune_verified_raw_release.mjs --source-root /var/lib/kcsc --include-root runs --state-file /var/lib/kcsc/raw-release-state/runs.json --min-age-ms 604800000 --apply --record-dir /var/lib/kcsc/raw-release-prune
Nice=15
CPUWeight=20
IOWeight=20
